                <textarea id="devis-message" name="message" required class="form-control" rows="6" 
                    placeholder="Décrivez vos besoins en détail (surface, fréquence, prestations souhaitées, etc.)"></textarea>
            </div>
            
            <button type="submit" class="btn btn-success btn-lg">
